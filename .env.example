# 탄생 마켓플레이스 — 로컬 개발용 환경변수 예시
# 실제 비밀값을 이 파일에 적지 않는다. 복사 후 .env.local 로 저장해 사용한다.
# cp .env.example .env.local

# --- 앱 환경 ---
APP_ENV=local
PUBLIC_DEPLOYMENT_ENABLED=false

# --- 기능 스위치 (기본값: 보수적 OFF) ---
DIRECT_SALE_ENABLED=false
PAYMENT_PROVIDER=mock
NOTIFICATION_PROVIDER=mock

# --- 신규 전용 PostgreSQL (기존 DB와 절대 공유 금지) ---
# M1 착수 시 로컬에 별도 설치/구성 예정. 기존 스마트팜/운영 홈페이지 DB 계정·포트 재사용 금지.
DATABASE_URL=postgresql://tansaeng_mkt_dev:changeme@127.0.0.1:55432/tansaeng_marketplace_dev

# --- 신규 전용 객체 스토리지 (MinIO 등, 추후 도입) ---
STORAGE_PROVIDER=local
STORAGE_ENDPOINT=http://127.0.0.1:59000
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=tansaeng-marketplace-dev

# --- 인증 (로컬 전용 시크릿, 운영 키와 무관) ---
AUTH_SECRET=change-me-in-local-env

# --- 타임존 ---
TZ=Asia/Seoul
