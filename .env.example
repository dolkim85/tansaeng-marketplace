# 탄생 마켓플레이스 — 로컬 개발용 환경변수 예시
# 실제 비밀값을 이 파일에 적지 않는다. 복사 후 .env.local 로 저장해 사용한다.
# cp .env.example .env.local

# --- 앱 환경 ---
APP_ENV=local
PUBLIC_DEPLOYMENT_ENABLED=false

# --- 기능 스위치 (기본값: 보수적 OFF) ---
DIRECT_SALE_ENABLED=false
PAYMENT_PROVIDER=mock
NOTIFICATION_PROVIDER=mock

# --- 신규 전용 DB (기존 DB와 절대 공유 금지) ---
# PostgreSQL 전용 인스턴스(127.0.0.1:55432, DB명 tansaeng_marketplace_dev)로 전환됨
# (docs/PRODUCT_DECISIONS.md, docs/ERD.md 참고). 아래는 로컬 전용 예시 자격증명 — 실제 비밀값이
# 아니며, 각자 로컬에서 동일한 이름으로 역할/DB를 생성해 사용한다(설치 절차는 docs/ERD.md 참고).
DATABASE_URL="postgresql://tansaeng_dev:tansaeng_dev_local_only@127.0.0.1:55432/tansaeng_marketplace_dev"

# --- 신규 전용 객체 스토리지 (MinIO 등, 추후 도입) ---
STORAGE_PROVIDER=local
STORAGE_ENDPOINT=http://127.0.0.1:59000
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=tansaeng-marketplace-dev

# --- 인증 (로컬 전용 시크릿, 운영 키와 무관) ---
AUTH_SECRET=change-me-in-local-env

# --- 타임존 ---
TZ=Asia/Seoul
