// 탄생 마켓플레이스 — 신규 독립 DB 스키마 (기존 운영 DB와 완전 분리)
// M1 단계: SQLite로 시작(설치 없는 로컬 개발), M2 진입 전 PostgreSQL로 전환 예정.
// 전환 시 datasource.provider만 바꾸고 마이그레이션을 재생성한다(docs/PRODUCT_DECISIONS.md 참고).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserRole {
  BUYER
  SELLER
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum SellerIdentityType {
  BUSINESS_PRODUCER
  FARM_ENTITY_ONLY
  PLATFORM_SUPPLIER
}

enum SellerApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum ProductStatus {
  DRAFT
  IN_REVIEW
  ON_SALE
  HIDDEN
  SOLD_OUT
}

enum OrderStatus {
  CREATED
  PAID
  CANCELLED
}

enum SuborderStatus {
  PENDING
  PREPARING
  SHIPPED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
  REFUNDED
}

enum SupportTicketStatus {
  OPEN
  ANSWERED
  CLOSED
}

enum SupportTicketCategory {
  PRODUCT_QUESTION
  ORDER_INQUIRY
  DISPUTE
}

enum AdPlacement {
  SEARCH
  CATEGORY_TOP
  HOME_BANNER
}

enum AdStatus {
  REQUESTED
  APPROVED
  REJECTED
}

/// DB에 저장되는 "기준" 상태. 실제 화면에 보이는 티저/오픈/마감 단계는
/// src/lib/groupBuyPhase.ts가 openAt/closeAt과 현재 시각을 비교해 계산한다(별도 스케줄러 없음).
/// SUCCEEDED/FAILED/CANCELLED는 관리자의 "마감 처리" 액션으로만 전이된다.
enum GroupBuyStatus {
  SCHEDULED
  SUCCEEDED
  FAILED
  CANCELLED
}

enum SettlementStatus {
  PENDING
  APPROVED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole @default(BUYER)
  status       UserStatus @default(APPROVED)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  seller              Seller?
  wishlists           Wishlist[]
  sellerFollows       SellerFollow[]
  cart                Cart?
  orders              Order[]
  groupBuyAlerts      GroupBuyAlert[]
  reviews             Review[]
  supportTickets      SupportTicket[]
  supportTicketMessages SupportTicketMessage[]
  notificationPreference NotificationPreference?

  @@index([role])
}

model Seller {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeName    String
  storeSlug    String   @unique
  identityType SellerIdentityType
  createdAt    DateTime @default(now())

  applications   SellerApplication[]
  products       Product[]
  follows        SellerFollow[]
  suborders      Suborder[]
  ads            Ad[]
  supportTickets SupportTicket[]
  settlements    Settlement[]
}

model SellerApplication {
  id          String                   @id @default(cuid())
  sellerId    String
  seller      Seller                   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  status      SellerApplicationStatus  @default(SUBMITTED)
  note        String?
  reviewedBy  String?
  reviewedAt  DateTime?
  createdAt   DateTime                 @default(now())

  @@index([status])
}

model Category {
  id       String     @id @default(cuid())
  slug     String     @unique
  name     String
  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]
}

model Product {
  id          String        @id @default(cuid())
  sellerId    String
  seller      Seller        @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  categoryId  String
  category    Category      @relation(fields: [categoryId], references: [id])
  slug        String        @unique
  title       String
  originRegion String
  priceKrw    Int
  stockQty    Int           @default(0)
  status      ProductStatus @default(DRAFT)
  description String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  /// 대리등록(마스터 문서 10.3절) — 운영자가 농가 대신 등록한 상품만 아래 필드를 채운다.
  /// 대리등록 상품은 판매자의 입점 승인 상태와 무관하게 항상 DRAFT로 시작하며,
  /// `approveProxyProductAction`(관리자 전용)으로만 ON_SALE로 전환된다
  /// (`approveApplicationAction`의 일괄 DRAFT→ON_SALE 전환 대상에서 제외됨).
  isProxyRegistered Boolean   @default(false)
  proxySourceNote   String?
  proxyConsentAt    DateTime?
  proxyRegisteredBy String?
  proxyApprovedAt   DateTime?
  proxyApprovedBy   String?

  media          ProductMedia[]
  wishlists      Wishlist[]
  cartItems      CartItem[]
  orderItems     OrderItem[]
  groupBuy       GroupBuy?
  reviews        Review[]
  ads            Ad[]
  supportTickets SupportTicket[]

  @@index([categoryId])
  @@index([sellerId])
  @@index([status])
}

model ProductMedia {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  kind      String   // "image" | "video"
  url       String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId])
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
}

model SellerFollow {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sellerId  String
  seller    Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, sellerId])
  @@index([userId])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int
  createdAt DateTime @default(now())

  @@unique([cartId, productId])
}

/// 구매자가 한 번에 결제한 총주문. 판매자별 하위주문(Suborder)으로 분리된다(문서 9.1).
model Order {
  id             String      @id @default(cuid())
  buyerId        String
  buyer          User        @relation(fields: [buyerId], references: [id])
  status         OrderStatus @default(CREATED)
  totalKrw       Int
  recipientName  String
  recipientPhone String
  addressLine    String
  createdAt      DateTime    @default(now())

  suborders      Suborder[]
  payment        Payment?
  supportTickets SupportTicket[]

  @@index([buyerId])
}

/// 판매자별 출고 단위. 같은 Order라도 판매자가 다르면 배송이 분리된다.
model Suborder {
  id           String         @id @default(cuid())
  orderId      String
  order        Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sellerId     String
  seller       Seller         @relation(fields: [sellerId], references: [id])
  status       SuborderStatus @default(PENDING)
  subtotalKrw  Int
  createdAt    DateTime       @default(now())
  settlementId String?
  settlement   Settlement?    @relation(fields: [settlementId], references: [id])

  items OrderItem[]

  @@index([orderId])
  @@index([sellerId])
  @@index([settlementId])
}

model OrderItem {
  id               String    @id @default(cuid())
  suborderId       String
  suborder         Suborder  @relation(fields: [suborderId], references: [id], onDelete: Cascade)
  productId        String
  product          Product   @relation(fields: [productId], references: [id])
  titleSnapshot    String
  priceKrwSnapshot Int
  quantity         Int
  groupBuyId       String?
  groupBuy         GroupBuy? @relation(fields: [groupBuyId], references: [id])
  review           Review?

  @@index([suborderId])
  @@index([groupBuyId])
}

/// Mock PG 전용. 실결제 연동 전까지 status는 로컬에서만 전이된다.
model Payment {
  id          String        @id @default(cuid())
  orderId     String        @unique
  order       Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status      PaymentStatus @default(PENDING)
  amountKrw   Int
  provider    String        @default("mock")
  confirmedAt DateTime?
  createdAt   DateTime      @default(now())
}

/// 공동구매. 문서 7장 — 상품 1개당 공동구매 1건(1:1). 알림 신청(GroupBuyAlert)은
/// 실제 결제 주문과 분리되어 목표수량에 집계되지 않는다(문서 7.2 필수 요건).
model GroupBuy {
  id             String         @id @default(cuid())
  productId      String         @unique
  product        Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  title          String
  targetQty      Int
  maxQty         Int
  perUserLimit   Int            @default(0) // 0 = 제한 없음
  priceKrw       Int
  teaserStartAt  DateTime
  openAt         DateTime
  closeAt        DateTime
  expectedShipAt DateTime
  status         GroupBuyStatus @default(SCHEDULED)
  createdAt      DateTime       @default(now())

  alerts     GroupBuyAlert[]
  orderItems OrderItem[]

  @@index([status])
}

model GroupBuyAlert {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupBuyId String
  groupBuy   GroupBuy @relation(fields: [groupBuyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, groupBuyId])
  @@index([groupBuyId])
}

/// 실제 구매 완료(Suborder.status=COMPLETED)한 주문 항목 1건당 리뷰 1개만 작성 가능(@@unique).
model Review {
  id          String    @id @default(cuid())
  orderItemId String    @unique
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  rating      Int
  comment     String
  sellerReply String?
  createdAt   DateTime  @default(now())

  @@index([productId])
}

/// 모의 광고. 실제 과금/결제 연동 없이 노출수(impressions)/클릭수(clicks)만 집계한다.
/// "활성" 여부는 status=APPROVED && startAt<=now<=endAt로 화면에서 그때그때 계산한다(스케줄러 없음).
model Ad {
  id          String      @id @default(cuid())
  sellerId    String
  seller      Seller      @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  productId   String
  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  placement   AdPlacement
  startAt     DateTime
  endAt       DateTime
  status      AdStatus    @default(REQUESTED)
  impressions Int         @default(0)
  clicks      Int         @default(0)
  reviewedBy  String?
  reviewedAt  DateTime?
  createdAt   DateTime    @default(now())

  @@index([status])
  @@index([placement])
}

/// 상품질문/주문문의/분쟁 티켓(문서 9.4절). 세 종류 모두 같은 상태기계(OPEN→ANSWERED→CLOSED)와
/// 메시지 스레드(SupportTicketMessage)를 공유한다. isPublic은 PRODUCT_QUESTION에서만 의미가 있고
/// (공개 질문은 상품 상세페이지 노출용), 그 외 카테고리는 항상 비공개로 취급한다.
model SupportTicket {
  id         String                @id @default(cuid())
  userId     String
  user       User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   SupportTicketCategory
  subject    String
  status     SupportTicketStatus   @default(OPEN)
  isPublic   Boolean               @default(false)
  productId  String?
  product    Product?              @relation(fields: [productId], references: [id])
  orderId    String?
  order      Order?                @relation(fields: [orderId], references: [id])
  sellerId   String?
  seller     Seller?               @relation(fields: [sellerId], references: [id])
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  messages SupportTicketMessage[]

  @@index([userId])
  @@index([sellerId])
  @@index([status])
}

model SupportTicketMessage {
  id         String        @id @default(cuid())
  ticketId   String
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId   String
  author     User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorRole UserRole
  body       String
  createdAt  DateTime      @default(now())

  @@index([ticketId])
}

/// 홈 메인 배너(마스터 문서 4.2절). 판매자가 신청하는 유료 Ad(HOME_BANNER)와는 별개로,
/// 운영자가 직접 작성하는 비과금 편집성 배너(공동구매 홍보, 공지 등). isActive인 것 중
/// sortOrder가 가장 낮은(우선순위 높은) 1건만 홈 화면에 노출된다(복수 노출/캐러셀 없음).
model Banner {
  id        String   @id @default(cuid())
  title     String
  subtitle  String?
  linkUrl   String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([isActive])
}

/// 공지사항. 고정(isPinned) 글이 항상 먼저, 그 다음 최신순으로 노출된다.
model Notice {
  id        String   @id @default(cuid())
  title     String
  body      String
  isPinned  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([isPinned])
}

/// 자주 묻는 질문. sortOrder 오름차순으로 노출(같으면 생성순).
model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([sortOrder])
}

/// 모의 정산 배치(마스터 문서 11.3절). 관리자가 "정산 실행"을 누른 시점에 그 판매자의
/// 아직 어떤 배치에도 포함되지 않은 COMPLETED(배송완료) Suborder들을 모아 스냅샷으로 만든다
/// (이후 생성되는 주문은 자동으로 다음 배치 대상이 됨 — 이중 집계 방지). commissionRate는
/// 생성 시점의 비율을 기록해 두어, 이후 전역 비율이 바뀌어도 과거 배치 금액은 바뀌지 않는다.
/// 생성 직후 PENDING이며, 관리자의 별도 "승인" 액션으로만 APPROVED(모의 지급 완료)로 전이한다.
model Settlement {
  id             String           @id @default(cuid())
  sellerId       String
  seller         Seller           @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  grossKrw       Int
  commissionRate Float
  commissionKrw  Int
  payoutKrw      Int
  status         SettlementStatus @default(PENDING)
  approvedBy     String?
  approvedAt     DateTime?
  createdAt      DateTime         @default(now())

  suborders Suborder[]

  @@index([sellerId])
  @@index([status])
}

/// 수신동의(마스터 문서 13장 alert_subscriptions 중 채널/동의 측면). 거래 알림(주문/배송/정산 등)은
/// 서비스 이용에 필수라 끄는 옵션을 두지 않고, 광고성 정보만 채널별(이메일/푸시)로 동의를 받는다.
model NotificationPreference {
  id                  String   @id @default(cuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  marketingEmailOptIn Boolean  @default(false)
  marketingPushOptIn  Boolean  @default(false)
  updatedAt           DateTime @updatedAt
}
