// 탄생 마켓플레이스 — 신규 독립 DB 스키마 (기존 운영 DB와 완전 분리)
// M1 단계: SQLite로 시작(설치 없는 로컬 개발), M2 진입 전 PostgreSQL로 전환 예정.
// 전환 시 datasource.provider만 바꾸고 마이그레이션을 재생성한다(docs/PRODUCT_DECISIONS.md 참고).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserRole {
  BUYER
  SELLER
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum SellerIdentityType {
  BUSINESS_PRODUCER
  FARM_ENTITY_ONLY
  PLATFORM_SUPPLIER
}

enum SellerApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum ProductStatus {
  DRAFT
  IN_REVIEW
  ON_SALE
  HIDDEN
  SOLD_OUT
}

enum OrderStatus {
  CREATED
  PAID
  CANCELLED
}

enum SuborderStatus {
  PENDING
  PREPARING
  SHIPPED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
  REFUNDED
}

/// DB에 저장되는 "기준" 상태. 실제 화면에 보이는 티저/오픈/마감 단계는
/// src/lib/groupBuyPhase.ts가 openAt/closeAt과 현재 시각을 비교해 계산한다(별도 스케줄러 없음).
/// SUCCEEDED/FAILED/CANCELLED는 관리자의 "마감 처리" 액션으로만 전이된다.
enum GroupBuyStatus {
  SCHEDULED
  SUCCEEDED
  FAILED
  CANCELLED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole @default(BUYER)
  status       UserStatus @default(APPROVED)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  seller          Seller?
  wishlists       Wishlist[]
  sellerFollows   SellerFollow[]
  cart            Cart?
  orders          Order[]
  groupBuyAlerts  GroupBuyAlert[]

  @@index([role])
}

model Seller {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeName    String
  storeSlug    String   @unique
  identityType SellerIdentityType
  createdAt    DateTime @default(now())

  applications SellerApplication[]
  products     Product[]
  follows      SellerFollow[]
  suborders    Suborder[]
}

model SellerApplication {
  id          String                   @id @default(cuid())
  sellerId    String
  seller      Seller                   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  status      SellerApplicationStatus  @default(SUBMITTED)
  note        String?
  reviewedBy  String?
  reviewedAt  DateTime?
  createdAt   DateTime                 @default(now())

  @@index([status])
}

model Category {
  id       String     @id @default(cuid())
  slug     String     @unique
  name     String
  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]
}

model Product {
  id          String        @id @default(cuid())
  sellerId    String
  seller      Seller        @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  categoryId  String
  category    Category      @relation(fields: [categoryId], references: [id])
  slug        String        @unique
  title       String
  originRegion String
  priceKrw    Int
  stockQty    Int           @default(0)
  status      ProductStatus @default(DRAFT)
  description String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  media      ProductMedia[]
  wishlists  Wishlist[]
  cartItems  CartItem[]
  orderItems OrderItem[]
  groupBuy   GroupBuy?

  @@index([categoryId])
  @@index([sellerId])
  @@index([status])
}

model ProductMedia {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  kind      String   // "image" | "video"
  url       String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId])
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
}

model SellerFollow {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sellerId  String
  seller    Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, sellerId])
  @@index([userId])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int
  createdAt DateTime @default(now())

  @@unique([cartId, productId])
}

/// 구매자가 한 번에 결제한 총주문. 판매자별 하위주문(Suborder)으로 분리된다(문서 9.1).
model Order {
  id             String      @id @default(cuid())
  buyerId        String
  buyer          User        @relation(fields: [buyerId], references: [id])
  status         OrderStatus @default(CREATED)
  totalKrw       Int
  recipientName  String
  recipientPhone String
  addressLine    String
  createdAt      DateTime    @default(now())

  suborders Suborder[]
  payment   Payment?

  @@index([buyerId])
}

/// 판매자별 출고 단위. 같은 Order라도 판매자가 다르면 배송이 분리된다.
model Suborder {
  id          String         @id @default(cuid())
  orderId     String
  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sellerId    String
  seller      Seller         @relation(fields: [sellerId], references: [id])
  status      SuborderStatus @default(PENDING)
  subtotalKrw Int
  createdAt   DateTime       @default(now())

  items OrderItem[]

  @@index([orderId])
  @@index([sellerId])
}

model OrderItem {
  id               String    @id @default(cuid())
  suborderId       String
  suborder         Suborder  @relation(fields: [suborderId], references: [id], onDelete: Cascade)
  productId        String
  product          Product   @relation(fields: [productId], references: [id])
  titleSnapshot    String
  priceKrwSnapshot Int
  quantity         Int
  groupBuyId       String?
  groupBuy         GroupBuy? @relation(fields: [groupBuyId], references: [id])

  @@index([suborderId])
  @@index([groupBuyId])
}

/// Mock PG 전용. 실결제 연동 전까지 status는 로컬에서만 전이된다.
model Payment {
  id          String        @id @default(cuid())
  orderId     String        @unique
  order       Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status      PaymentStatus @default(PENDING)
  amountKrw   Int
  provider    String        @default("mock")
  confirmedAt DateTime?
  createdAt   DateTime      @default(now())
}

/// 공동구매. 문서 7장 — 상품 1개당 공동구매 1건(1:1). 알림 신청(GroupBuyAlert)은
/// 실제 결제 주문과 분리되어 목표수량에 집계되지 않는다(문서 7.2 필수 요건).
model GroupBuy {
  id             String         @id @default(cuid())
  productId      String         @unique
  product        Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  title          String
  targetQty      Int
  maxQty         Int
  perUserLimit   Int            @default(0) // 0 = 제한 없음
  priceKrw       Int
  teaserStartAt  DateTime
  openAt         DateTime
  closeAt        DateTime
  expectedShipAt DateTime
  status         GroupBuyStatus @default(SCHEDULED)
  createdAt      DateTime       @default(now())

  alerts     GroupBuyAlert[]
  orderItems OrderItem[]

  @@index([status])
}

model GroupBuyAlert {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupBuyId String
  groupBuy   GroupBuy @relation(fields: [groupBuyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, groupBuyId])
  @@index([groupBuyId])
}
